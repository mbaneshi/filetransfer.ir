APP_ENV=development
API_PORT=18474
DATABASE_URL=postgres://filetransfer:filetransfer@postgres:5432/filetransfer?sslmode=disable
REDIS_URL=redis://redis:6379/0
MAX_FILE_SIZE_BYTES=53687091200
PUBLIC_BASE_URL=http://localhost:3000

# Provider credentials are intentionally empty in local development.
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFY_TEMPLATE=
# Required outside development: HMAC key for stored OTPs (openssl rand -hex 32).
OTP_SECRET=
# Set to 1 only when exactly one trusted reverse proxy (Traefik) is in front.
TRUST_PROXY=
ZIBAL_MERCHANT=
OBJECT_STORAGE_ENDPOINT=http://s3:7070
# Browsers use this host in presigned URLs; defaults to OBJECT_STORAGE_ENDPOINT.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:19000
OBJECT_STORAGE_REGION=us-east-1
# Arvan: 0 (virtual-host style). Local versitygw: 1.
OBJECT_STORAGE_PATH_STYLE=1
OBJECT_STORAGE_BUCKET=filetransfer
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

