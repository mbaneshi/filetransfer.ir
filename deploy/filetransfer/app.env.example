# Template for /opt/filetransfer/app.env on the box. bootstrap.sh writes the real file
# with generated secrets; every value still set to the placeholder below must be filled in by hand.
# ft-deploy refuses to run while any placeholder remains. Never commit the real file.

# Where the app is served. Staging first; switch to filetransfer.ir after its DNS exists.
FT_HOST=ft.webcad.ir
PUBLIC_BASE_URL=https://ft.webcad.ir
# Staging stays out of search engines. Set to "index, follow" at launch.
FT_ROBOTS=noindex, nofollow

# Generated by bootstrap.sh
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://filetransfer:CHANGE_ME@ft-postgres:5432/filetransfer?sslmode=disable
REDIS_URL=redis://ft-redis:6379/0
OTP_SECRET=CHANGE_ME

# Kavenegar verify/lookup template (an approved template that takes one token)
KAVENEGAR_API_KEY=CHANGE_ME
KAVENEGAR_VERIFY_TEMPLATE=CHANGE_ME

MAX_FILE_SIZE_BYTES=53687091200

# Arvan Object Storage. The panel shows ir-central1 (Tehran) for new buckets; the older name ir-thr-at1 reaches the same cluster.
# The signing region is verified only with a real key (aws s3api head-bucket --region ...): if uploads fail with a signature error, try ir-thr-at1.
OBJECT_STORAGE_ENDPOINT=https://s3.ir-central1.arvanstorage.ir
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://s3.ir-central1.arvanstorage.ir
OBJECT_STORAGE_REGION=ir-central1
OBJECT_STORAGE_PATH_STYLE=0
OBJECT_STORAGE_BUCKET=CHANGE_ME
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
